{
  "$schema": "https://biomejs.dev/schemas/2.2.0/schema.json",
  "vcs": {
    "enabled": true,
    "clientKind": "git",
    "useIgnoreFile": true
  },
  "files": {
    "ignoreUnknown": true,
    "includes": [
      "**",
      "!node_modules",
      "!.next",
      "!dist",
      "!build"
    ]
  },
  "formatter": {
    "enabled": true,
    "lineWidth": 80,
    "formatWithErrors": false,
    "attributePosition": "auto",
    "bracketSpacing": true,
    "useEditorconfig": true,
    "bracketSameLine": false,
    "expand": "auto"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "recommended": true,
      "suspicious": {
        "recommended": true,
        "noUnknownAtRules": "off",
        "noExplicitAny": "warn",
        "noArrayIndexKey": "warn",
        "useStrictMode": "warn",
        "noVar": "warn"
      },
      "correctness": {
        "recommended": true,
        "noUnusedVariables": "error",
        "noUnusedImports": "error"
      },
      "style": {
        "recommended": true,
        "noCommonJs": "error",
        "noMagicNumbers": "warn",
        "useImportType": "error"
      },
      "a11y": {
        "recommended": true,
        "useAltText": "error",
        "useHtmlLang": "error",
        "useButtonType": "error"
      }
    },
    "domains": {
      "next": "recommended",
      "react": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "recommended": true,
        "organizeImports": {
          "level": "on",
          "options": {
            "groups": [
              [
                ":BUN:",
                ":NODE:"
              ],
              ":BLANK_LINE:",
              [
                ":PACKAGE:",
                "!@myown/**"
              ],
              ":BLANK_LINE:",
              "@myown/**",
              ":BLANK_LINE:",
              [
                ":ALIAS:",
                ":PATH:"
              ]
            ]
          }
        }
      }
    }
  },
  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "asNeeded",
      "trailingCommas": "none",
      "arrowParentheses": "asNeeded",
      "jsxQuoteStyle": "single",
      "quoteProperties": "asNeeded",
      "attributePosition": "auto",
      "bracketSpacing": true,
      "bracketSameLine": false,
      "operatorLinebreak": "after",
      "expand": "auto"
    }
  }
}